+# Distribution sessions in "contains the ones after it" order: HOL-Analysis
+# includes HOL-Computational_Algebra, HOL-Library and HOL-Combinatorics;
+# HOL-Number_Theory includes HOL-Computational_Algebra; and so on. A file that
+# mixes two incomparable sessions (HOL-Algebra + HOL-Analysis) gets the first
+# in this order and loads the rest from source, as before.
+_FIELD_ORDER = ("HOL-Probability", "HOL-Analysis", "HOL-Number_Theory", "HOL-Algebra",
+                "HOL-Computational_Algebra", "HOL-Combinatorics", "HOL-Library")
+
+
+def field_from_imports(imports: List[str]) -> Optional[str]:
+    """The session (logic image) a file's dotted imports imply; None when every
+    import is unqualified (Main, Complex_Main: the default field serves)."""
+    sessions = {i.split(".", 1)[0] for i in imports if "." in i}
+    for s in _FIELD_ORDER:
+        if s in sessions:
+            return s
+    return next(iter(sorted(sessions)), None)
+
